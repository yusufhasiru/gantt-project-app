# Salin file ini menjadi server/.env lalu isi nilai yang aman.
# Prisma membaca DATABASE_URL dari server/.env (relatif terhadap server/prisma).
DATABASE_URL="file:./dev.db"

# Wajib diisi, minimal 32 karakter acak. Server menolak start jika kosong,
# terlalu pendek, atau memakai nilai contoh di bawah.
# Hasilkan dengan: openssl rand -hex 32
JWT_SECRET="ganti-dengan-secret-acak-panjang-minimal-32-karakter"

PORT=3001
NODE_ENV=development

# Origin frontend yang diizinkan (dipisah koma)
CORS_ORIGIN="http://localhost:5173"
